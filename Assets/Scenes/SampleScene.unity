  m_Script: {fileID: 11500000, guid: bd4ba57952f78394aa05eeeba1f6b390, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableDocument
  documentTitle: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
  documentText: "\u042D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u0440 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430.\n\n\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435
    \u0431\u043B\u0438\u0436\u0435 \u0438 \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
    \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430 \u043B\u0438\u0441\u0442. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    E, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
    \u0435\u0433\u043E.\n\n\u0417\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A
    \u0438 \u0442\u0435\u043A\u0441\u0442 \u044D\u0442\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u043A\u0438
    \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
    \u0432 Inspector \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0435 Test
    Document."
