--- !u!114 &1715122346
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1715122345}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a59ebb1e58ca02d4fa2bc995dce71230, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  characterName: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C"
  nodes:
  - npcText: "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u043F\u0440\u0438\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E
      \u0437\u0430 \u044D\u0442\u0438\u043C \u043C\u0435\u0441\u0442\u043E\u043C.
      \u0427\u0442\u043E \u0442\u0435\u0431\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442?"
    choices:
    - text: "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u043C\u0435\u0441\u0442\u043E?"
      nextNode: 1
    - text: "\u0427\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E
        \u0434\u0435\u043B\u0430\u0442\u044C?"
      nextNode: 2
    - text: "\u041F\u043E\u043A\u0430!"
      nextNode: 3
  - npcText: "\u042D\u0442\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430. \u0417\u0434\u0435\u0441\u044C
      \u043C\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043D\u043E\u0432\u044B\u0435
      \u0438\u0433\u0440\u043E\u0432\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438."
    choices:
    - text: "\u0410 \u0447\u0442\u043E \u0437\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
        \u0432\u043E\u043A\u0440\u0443\u0433?"
      nextNode: 2
    - text: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C"
      nextNode: 0
    - text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0434\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438."
      nextNode: 3
  - npcText: "\u041C\u043E\u0436\u043D\u043E \u0447\u0438\u0442\u0430\u0442\u044C
      \u0437\u0430\u043F\u0438\u0441\u043A\u0438 \u0438 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B. \u041F\u043E\u0434\u043E\u0439\u0434\u0438
      \u043F\u043E\u0431\u043B\u0438\u0436\u0435 \u0438 \u043D\u0430\u0436\u043C\u0438
      E."
    choices:
    - text: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E, \u0441\u043F\u0430\u0441\u0438\u0431\u043E!"
      nextNode: 3
    - text: "\u0423 \u043C\u0435\u043D\u044F \u0435\u0449\u0451 \u0432\u043E\u043F\u0440\u043E\u0441."
      nextNode: 0
  - npcText: "\u0423\u0434\u0430\u0447\u0438 \u0441 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u043C!
      \u0415\u0441\u043B\u0438 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
      \u043F\u043E\u043C\u043E\u0449\u044C, \u044F \u0431\u0443\u0434\u0443 \u0437\u0434\u0435\u0441\u044C."
    choices:
    - text: "\u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
      nextNode: -1
    - text: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0435\u0449\u0451"
      nextNode: 0
